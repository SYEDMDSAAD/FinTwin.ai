# The React app plus the front-door proxy, for Google Cloud Run.
# Build from the REPO ROOT:
#   docker build -f frontend/Dockerfile.cloudrun -t fintwin-web .

FROM node:26-alpine AS build
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ .
ARG VITE_GOOGLE_CLIENT_ID=""
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx/nginx.cloudrun.conf.template /etc/nginx/templates/default.conf.template

ENV PORT=8080 \
    NGINX_ENVSUBST_OUTPUT_DIR=/etc/nginx/conf.d

EXPOSE 8080
