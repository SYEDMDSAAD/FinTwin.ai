# alertmanager-secret.yaml.template — DO NOT commit filled values to git.
#
# Holds the SMTP password Alertmanager uses to send alert emails, mounted at
# /etc/alertmanager/secrets/smtp-password (referenced by smtp_auth_password_file
# in alertmanager.yaml).
#
# Usage:
#   1. Copy to alertmanager-secret.yaml
#   2. Replace the placeholder with your SMTP app password
#   3. kubectl apply -f k8s/monitoring/alertmanager-secret.yaml
#
# stringData lets you paste the raw value (no base64). For Gmail, use an App
# Password, not the account password.
apiVersion: v1
kind: Secret
metadata:
  name: alertmanager-secret
  namespace: fintwin
type: Opaque
stringData:
  smtp-password: "CHANGE_ME_SMTP_APP_PASSWORD"
  # If enabling the Slack receiver in alertmanager.yaml, add the webhook URL too:
  # slack-webhook: "https://hooks.slack.com/services/XXX/YYY/ZZZ"
