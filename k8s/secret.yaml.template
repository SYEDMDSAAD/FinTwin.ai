# secret.yaml.template — DO NOT commit filled values to git.
#
# How to use:
#   1. Copy this file to secret.yaml
#   2. Base64-encode each value:  echo -n 'your-value' | base64
#   3. Replace every <BASE64_...> placeholder with the encoded value
#   4. Apply:  kubectl apply -f k8s/secret.yaml
#
# In CI/CD (recommended): generate this file from your secrets manager
# (AWS Secrets Manager, HashiCorp Vault, GCP Secret Manager) and never
# store the filled file in the repository.
#
# For production: consider using the External Secrets Operator
# (https://external-secrets.io) to sync secrets from your secrets manager
# directly into Kubernetes without manual base64 encoding.

apiVersion: v1
kind: Secret
metadata:
  name: fintwin-secrets
  namespace: fintwin
type: Opaque
data:
  # Generate: echo -n 'your-password' | base64
  DB_PASSWORD:              <BASE64_DB_PASSWORD>

  # Redis auth. Generate a password: openssl rand -base64 24
  # REDIS_PASSWORD is consumed by the Redis pod (--requirepass) AND must match
  # the password embedded in REDIS_URL below, which the backend connects with.
  #   REDIS_PASSWORD:  echo -n 'your-redis-password' | base64
  #   REDIS_URL:       echo -n 'redis://:your-redis-password@redis-service:6379' | base64
  # REDIS_URL lives here (not the ConfigMap) because it now carries a credential.
  REDIS_PASSWORD:           <BASE64_REDIS_PASSWORD>
  REDIS_URL:                <BASE64_REDIS_URL>

  # Minimum 32 characters: openssl rand -base64 32 | base64
  JWT_SECRET:               <BASE64_JWT_SECRET>

  # openssl rand -base64 32 | base64
  FINTWIN_ENCRYPTION_KEY:   <BASE64_ENCRYPTION_KEY>

  # openssl rand -hex 32 | base64
  AI_INTERNAL_KEY:          <BASE64_AI_INTERNAL_KEY>

  # openssl rand -hex 32 | base64
  ADMIN_KEY:                <BASE64_ADMIN_KEY>

  # From Google Cloud Console → APIs & Services → Credentials | base64
  GOOGLE_CLIENT_ID:         <BASE64_GOOGLE_CLIENT_ID>

  # From bridge.setu.co | base64
  SETU_CLIENT_ID:           <BASE64_SETU_CLIENT_ID>
  SETU_CLIENT_SECRET:       <BASE64_SETU_CLIENT_SECRET>
  SETU_PRODUCT_INSTANCE_ID: <BASE64_SETU_PRODUCT_INSTANCE_ID>
  SETU_REDIRECT_URL:        <BASE64_SETU_REDIRECT_URL>

  # SMTP credentials | base64
  MAIL_USERNAME:            <BASE64_MAIL_USERNAME>
  MAIL_PASSWORD:            <BASE64_MAIL_PASSWORD>

  # Comma-separated allowed origins | base64
  # e.g. echo -n 'https://app.fintwin.ai' | base64
  CORS_ALLOWED_ORIGINS:     <BASE64_CORS_ALLOWED_ORIGINS>
