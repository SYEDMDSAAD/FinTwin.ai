# ── Secrets ───────────────────────────────────────────────────────────────────
.env
backend/.env
ai-service/.env

# Filled Kubernetes secrets — the *.template files are committed, the real
# values (produced by copying a template) must never be. The negation keeps
# templates tracked even though they match the *-secret.yaml glob logic.
k8s/secret.yaml
k8s/**/*-secret.yaml
!k8s/**/*-secret.yaml.template

# ── Java / Maven ──────────────────────────────────────────────────────────────
target/
*.class
*.jar
*.war
*.ear
*.iml
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
venv/
.venv/
*.egg-info/
dist/
build/

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.suo
*.swp
*.DS_Store

# ── Local tooling ─────────────────────────────────────────────────────────────
.claude/
*.deb
*.rpm
.pytest_cache/
