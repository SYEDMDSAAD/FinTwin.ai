# ── FinTwin Identity Service — Required Environment Variables ─────────────────
# Copy to .env and fill in values. JWT_SECRET and FINTWIN_ENCRYPTION_KEY
# MUST match the main backend exactly — both services share the same tokens and DB.

# Database (same DB as the main backend)
DB_URL=jdbc:postgresql://your-db-host:5432/fintwin?sslmode=require
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# JWT — MUST match the main backend's JWT_SECRET
JWT_SECRET=replace-with-a-long-random-string-min-32-chars

# AES-256 encryption key — MUST match the main backend's FINTWIN_ENCRYPTION_KEY
FINTWIN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# CORS — comma-separated allowed frontend origins
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# Admin bootstrap key (used once to create the first admin account)
# Generate: openssl rand -hex 32
ADMIN_KEY=replace-with-hex-key

# Internal service key — used by /api/token/introspect
# Set the same value in the main backend's INTERNAL_KEY env var
INTERNAL_KEY=replace-with-hex-key

# App base URL (for password reset links in emails)
APP_BASE_URL=https://your-frontend-domain.com

# Mail (optional — enables password reset and OTP emails)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENABLED=false

# Identity service port (default 8090)
IDENTITY_PORT=8090
