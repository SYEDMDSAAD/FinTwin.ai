<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <!-- Every line is masked before it is written: emails, UPI IDs, phone, card,
       Aadhaar and account numbers, PANs, credentials (com.fintwin.util.PiiRedactor).
       Users appear as userRef, a keyed hash of their email: an admin can find
       a user's lines from users.email_hash, but the log itself names nobody. -->
  <conversionRule conversionWord="maskedMsg" class="com.fintwin.logging.MaskedMessageConverter"/>
  <conversionRule conversionWord="maskedEx" class="com.fintwin.logging.MaskedThrowableConverter"/>

  <!-- ── Development / staging: human-readable console ── -->
  <springProfile name="!prod">
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
      <encoder>
        <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} traceId=%X{traceId:-} userRef=%X{userRef:-} - %maskedMsg%n%maskedEx</pattern>
      </encoder>
    </appender>
    <root level="INFO">
      <appender-ref ref="CONSOLE"/>
    </root>
    <logger name="com.fintwin" level="DEBUG"/>
    <logger name="org.springframework.security" level="WARN"/>
    <logger name="io.github.resilience4j" level="DEBUG"/>
  </springProfile>

  <!-- ── Production: structured JSON (Loki / ELK / CloudWatch-ready) ── -->
  <springProfile name="prod">
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
      <encoder class="net.logstash.logback.encoder.LogstashEncoder">
        <includeMdcKeyName>traceId</includeMdcKeyName>
        <includeMdcKeyName>spanId</includeMdcKeyName>
        <includeMdcKeyName>userRef</includeMdcKeyName>
        <includeMdcKeyName>requestId</includeMdcKeyName>
        <customFields>{"service":"fintwin-backend","version":"0.1.0"}</customFields>
        <jsonGeneratorDecorator class="net.logstash.logback.mask.MaskingJsonGeneratorDecorator">
          <valueMasker class="com.fintwin.logging.PiiValueMasker"/>
        </jsonGeneratorDecorator>
        <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
          <maxDepthPerCause>10</maxDepthPerCause>
          <rootCauseFirst>true</rootCauseFirst>
        </throwableConverter>
      </encoder>
    </appender>
    <root level="INFO">
      <appender-ref ref="JSON"/>
    </root>
    <logger name="com.fintwin" level="INFO"/>
    <logger name="org.springframework.security" level="WARN"/>
    <logger name="io.github.resilience4j" level="INFO"/>
    <!-- Suppress noisy Hibernate SQL in prod -->
    <logger name="org.hibernate.SQL" level="WARN"/>
  </springProfile>

</configuration>
