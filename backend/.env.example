# ── FinTwin Backend — Required Environment Variables ──────────────────────────
# Copy this file to .env (never commit .env to git) and fill in production values.

# Database
DB_URL=jdbc:postgresql://your-db-host:5432/fintwin?sslmode=require
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# JWT — minimum 32 characters
# Generate: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-min-32-chars

# AES-256 field encryption key — must be exactly 32 bytes, Base64-encoded
# Generate: openssl rand -base64 32
FINTWIN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# AI Service URL
AI_SERVICE_URL=http://localhost:8000

# Shared secret between backend and AI service — generate with: openssl rand -hex 32
AI_INTERNAL_KEY=replace-with-32-byte-hex-key

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# JPA (set to validate or none in production — never update)
DDL_AUTO=validate
SHOW_SQL=false
