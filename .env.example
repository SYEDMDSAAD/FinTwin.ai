# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=fintwin
POSTGRES_USER=postgres
POSTGRES_PASSWORD=        # required — use a strong random password

# ── Encryption (generate with: openssl rand -base64 32) ───────────────────────
FINTWIN_ENCRYPTION_KEY=   # required — 32-byte Base64 key for AES-256-GCM

# ── JWT (generate with: openssl rand -base64 64) ──────────────────────────────
JWT_SECRET=               # required — min 64 random chars

# ── Internal service auth (generate with: openssl rand -hex 32) ───────────────
# Must be the same value in both backend and ai-service containers
AI_INTERNAL_KEY=          # required

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ── Setu Account Aggregator ───────────────────────────────────────────────────
SETU_BASE_URL=https://fiu.setu.co   # use https://fiu-uat.setu.co for sandbox
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_REDIRECT_URL=https://yourdomain.com/bank-connected
SETU_PRODUCT_INSTANCE_ID=
# No webhook secret needed — Setu signs webhooks with JWS; verified via their public JWKS.

# ── Monitoring ────────────────────────────────────────────────────────────────
# Grafana admin password (local: http://localhost:3001, default: admin)
GRAFANA_ADMIN_PASSWORD=change_me_strong_password

# ── SMS (MSG91) ───────────────────────────────────────────────────────────────
SMS_ENABLED=false
SMS_API_KEY=
SMS_SENDER_ID=FTWIN
SMS_OTP_TEMPLATE_ID=
SMS_ALERT_TEMPLATE_ID=

# ── Bank alert emails (optional) ──────────────────────────────────────────────
# Users forward bank alerts to u-<token>@INBOUND_EMAIL_DOMAIN; a Cloudflare Email
# Worker (ops/email-worker) relays them here. Leave both empty to switch off.
INBOUND_EMAIL_DOMAIN=
INBOUND_EMAIL_SECRET=     # openssl rand -hex 32 — same value in the worker
