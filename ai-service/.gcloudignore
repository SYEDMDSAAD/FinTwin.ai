# What `gcloud builds submit` / `gcloud run deploy --source` leave out of the
# upload to Cloud Build. Secrets never leave this machine: the services get
# their settings as Cloud Run environment variables instead.
.gcloudignore
.git/
.gitignore
.env
.env.*
!.env.example
*.pem
*.key
*.p12
application_default_credentials*.json
service-account*.json

# Dependencies and build output: rebuilt inside the image
venv/
.venv/
node_modules/
target/
dist/
__pycache__/
*.pyc
.pytest_cache/
*.log
evals/results/
