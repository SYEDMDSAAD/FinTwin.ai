{
  "title": "FinTwin.ai — Production Dashboard",
  "uid": "fintwin-prod",
  "schemaVersion": 38,
  "tags": ["fintwin"],
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [{
        "expr": "rate(http_server_requests_seconds_count{application=\"fintwin-backend\"}[1m])",
        "legendFormat": "{{method}} {{uri}} {{status}}"
      }]
    },
    {
      "id": 2,
      "title": "HTTP P99 Latency (ms)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [{
        "expr": "histogram_quantile(0.99, rate(http_server_requests_seconds_bucket{application=\"fintwin-backend\"}[5m])) * 1000",
        "legendFormat": "p99 {{uri}}"
      }]
    },
    {
      "id": 3,
      "title": "HTTP Error Rate (5xx / total)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 4 },
      "targets": [{
        "expr": "sum(rate(http_server_requests_seconds_count{application=\"fintwin-backend\",status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count{application=\"fintwin-backend\"}[5m]))",
        "legendFormat": "Error rate"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 4,
      "title": "Logins (success vs failure)",
      "type": "timeseries",
      "gridPos": { "x": 6, "y": 8, "w": 12, "h": 4 },
      "targets": [
        { "expr": "rate(fintwin_auth_logins_total{result=\"success\"}[1m])", "legendFormat": "Success" },
        { "expr": "rate(fintwin_auth_logins_total{result=\"failure\"}[1m])", "legendFormat": "Failure" }
      ]
    },
    {
      "id": 5,
      "title": "New Registrations",
      "type": "stat",
      "gridPos": { "x": 18, "y": 8, "w": 6, "h": 4 },
      "targets": [{
        "expr": "increase(fintwin_registrations_total[24h])",
        "legendFormat": "24h registrations"
      }]
    },
    {
      "id": 6,
      "title": "HikariCP Active Connections",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 6 },
      "targets": [
        { "expr": "hikaricp_connections_active{pool=\"FintwinPool\"}", "legendFormat": "Active" },
        { "expr": "hikaricp_connections_pending{pool=\"FintwinPool\"}", "legendFormat": "Pending" },
        { "expr": "hikaricp_connections_max{pool=\"FintwinPool\"}", "legendFormat": "Max" }
      ]
    },
    {
      "id": 7,
      "title": "AI Forecast — Calls vs Fallbacks",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 6 },
      "targets": [
        { "expr": "rate(fintwin_ai_requests_total{type=\"forecast\",path=\"ai\"}[1m])", "legendFormat": "AI calls" },
        { "expr": "rate(fintwin_ai_requests_total{type=\"forecast\",path=\"fallback\"}[1m])", "legendFormat": "Fallbacks" }
      ]
    },
    {
      "id": 8,
      "title": "AI Forecast P99 Latency (s)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 18, "w": 6, "h": 4 },
      "targets": [{
        "expr": "histogram_quantile(0.99, rate(fintwin_ai_forecast_duration_seconds_bucket[5m]))",
        "legendFormat": "p99 latency"
      }]
    },
    {
      "id": 9,
      "title": "Circuit Breaker State (ai-service)",
      "type": "stat",
      "gridPos": { "x": 6, "y": 18, "w": 6, "h": 4 },
      "targets": [{
        "expr": "resilience4j_circuitbreaker_state{name=\"ai-service\"}",
        "legendFormat": "{{state}}"
      }]
    },
    {
      "id": 10,
      "title": "Transactions Created",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 18, "w": 12, "h": 4 },
      "targets": [{
        "expr": "rate(fintwin_transactions_created_total[5m])",
        "legendFormat": "tx/s"
      }]
    },
    {
      "id": 11,
      "title": "SMS — Sent vs Failed",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 22, "w": 12, "h": 4 },
      "targets": [
        { "expr": "rate(fintwin_sms_total{type=\"otp\"}[5m])", "legendFormat": "Sent" },
        { "expr": "rate(fintwin_sms_total{type=\"failed\"}[5m])", "legendFormat": "Failed" }
      ]
    },
    {
      "id": 12,
      "title": "JVM Heap Used (MB)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 22, "w": 12, "h": 4 },
      "targets": [{
        "expr": "jvm_memory_used_bytes{area=\"heap\",application=\"fintwin-backend\"} / 1048576",
        "legendFormat": "Heap used MB"
      }]
    }
  ]
}
