<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!-- CVE-2026-41855 (CVSSv3 9.8, CRITICAL) — arbitrary class instantiation via
         gadget deserialization in org.springframework.jms.support.converter.
         MappingJackson2MessageConverter / JacksonJsonMessageConverter, exploitable
         only in an untrusted JMS environment. No fix exists yet as of this writing
         (affects every current Spring Framework line: 7.0.7, 6.2.18, 6.1.27, 5.3.48).
         Flagged against whichever org.springframework module jar happens to match
         the broad "Spring Framework" CPE in a given scan run (seen against both
         spring-core and spring-tx across runs) — dependency-check assigns it to
         any artifact in the affected version range regardless of which module is
         actually vulnerable. Neither backend nor identity-service use Spring JMS
         or either message converter — verified via `grep -r "spring-jms\|
         JmsTemplate\|MappingJackson2MessageConverter\|JacksonJsonMessageConverter"`
         across both services' src trees, 2026-07-05. Suppress across the whole
         groupId rather than chase which module it lands on next. Re-evaluate if
         JMS messaging is ever introduced. -->
    <suppress>
        <notes><![CDATA[
        Unreachable: neither backend nor identity-service use Spring JMS or the
        affected message converters. See comment above for verification details.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework/.*$</packageUrl>
        <cve>CVE-2026-41855</cve>
    </suppress>

</suppressions>
